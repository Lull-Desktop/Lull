{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "target": "ES2021",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@lull/widget-sdk": ["./packages/widget-sdk/src/index.ts"],
      "@lull/widget-sdk/react": ["./packages/widget-sdk/src/react.ts"],
      "@lull/widget-sdk/vue": ["./packages/widget-sdk/src/vue.ts"],
      "@lull/widget-sdk/testing": ["./packages/widget-sdk/src/testing.ts"],
      "@lull/scene-sdk": ["./packages/scene-sdk/src/index.ts"],
      "@lull/scene-sdk/testing": ["./packages/scene-sdk/src/testing.ts"],
      "@lull/game-sdk": ["./packages/game-sdk/src/index.ts"],
      "@lull/game-sdk/widget": ["./packages/game-sdk/src/widget.ts"],
      "@lull/game-sdk/controller": ["./packages/game-sdk/src/controller.ts"],
      "@lull/game-sdk/scene": ["./packages/game-sdk/src/scene.ts"],
      "@lull/game-sdk/diagnostics": ["./packages/game-sdk/src/diagnostics.ts"],
      "@lull/game-sdk/testing": ["./packages/game-sdk/src/testing.ts"],
      "@lull/game-adapter-canvas": [
        "./packages/game-adapter-canvas/src/index.ts"
      ],
      "@lull/game-adapter-phaser": [
        "./packages/game-adapter-phaser/src/index.ts"
      ],
      "@lull/game-adapter-pixi": ["./packages/game-adapter-pixi/src/index.ts"],
      "@lull/game-adapter-three": [
        "./packages/game-adapter-three/src/index.ts"
      ],
      "@lull/media-sdk": ["./packages/media-sdk/src/index.ts"],
      "@lull/media-sdk/react": ["./packages/media-sdk/src/react.tsx"],
      "@lull/media-sdk/widget": ["./packages/media-sdk/src/widget.ts"],
      "@lull/media-sdk/testing": ["./packages/media-sdk/src/testing.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "dist/types/**/*.ts",
    "./*.mjs",
    "./*.mts",
    "dist/dev/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src-tauri/target", "website"]
}
