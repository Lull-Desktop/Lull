{
  "name": "lull",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev:next": "pnpm i18n:compile && next dev --turbopack",
    "build:next": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-mode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-mode.ps1",
    "content:check": "node scripts/validate-content.mjs",
    "content:hash": "node scripts/hash-content.mjs",
    "content:keygen": "node scripts/sign-content.mjs --init",
    "content:sign": "node scripts/sign-content.mjs",
    "content:verify": "node scripts/sign-content.mjs --verify",
    "content:pack": "node scripts/pack-content.mjs",
    "widgets:gen": "node scripts/gen-widgets.mjs",
    "widgets:check": "node scripts/gen-widgets.mjs --check",
    "widgets:sdk": "tsc -p packages/widget-sdk/tsconfig.json",
    "widgets:sdk:check": "tsc -p packages/widget-sdk/tsconfig.check.json",
    "scenes:sdk": "tsc -p packages/scene-sdk/tsconfig.json",
    "scenes:sdk:check": "tsc -p packages/scene-sdk/tsconfig.check.json",
    "scenes:samples:build": "pnpm scenes:sdk && node scripts/build-scene-examples.mjs",
    "scenes:samples:hash": "node scripts/hash-content.mjs --bundle examples/content/param-demo && node scripts/hash-content.mjs --bundle examples/content/three-scene",
    "scenes:samples:check": "node scripts/hash-content.mjs --bundle examples/content/param-demo --check && node scripts/hash-content.mjs --bundle examples/content/three-scene --check",
    "scenes:samples:pack": "node scripts/pack-content.mjs examples/content/param-demo --out artifacts && node scripts/pack-content.mjs examples/content/three-scene --out artifacts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "widgets:samples:build": "pnpm widgets:sdk && node scripts/build-widget-examples.mjs",
    "widgets:samples:install": "node scripts/install-widget-examples.mjs",
    "widget:pack": "node scripts/pack-widget.mjs",
    "widgets:samples:pack": "node scripts/pack-widget.mjs examples/widgets/pomodoro-js/dist examples/widgets/pomodoro-react/dist examples/widgets/pomodoro-vue/dist --tampered",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm content:check && pnpm widgets:check && pnpm widgets:sdk:check && pnpm scenes:sdk:check && pnpm scenes:samples:check",
    "tauri": "tauri",
    "format": "biome format",
    "lint": "biome check",
    "fix": "biome check --write",
    "dev": "tauri dev",
    "build": "tauri build",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "pretest": "node scripts/i18n-compile.mjs",
    "pretypecheck": "node scripts/i18n-compile.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.29.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "~7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
