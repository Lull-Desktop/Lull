{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-widgets",
  "description": "Third-party widget windows (label widget-*). Generated by scripts/gen-widgets.mjs — do not edit by hand.",
  "windows": [
    "widget-*"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-widget-state-get",
    "allow-widget-state-set",
    "allow-widget-state-remove",
    "allow-widget-set-transparent"
  ]
}
