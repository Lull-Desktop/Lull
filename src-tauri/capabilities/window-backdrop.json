{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-backdrop",
  "description": "Lull backdrop window (generated from src/widgets/manifests/backdrop.json).",
  "windows": [
    "backdrop"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-set-resizable",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "allow-window-set-frame",
    "allow-media-assets",
    "allow-media-asset-url",
    "allow-media-asset-pick-many",
    "allow-media-asset-remove",
    "allow-media-asset-rename",
    "allow-media-asset-prune",
    "allow-media-activate"
  ]
}
