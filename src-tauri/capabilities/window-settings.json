{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-settings",
  "description": "Lull settings window (generated from src/widgets/manifests/settings.json).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-set-resizable",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "allow-content-packages",
    "allow-content-trust-policy-get",
    "allow-content-trust-policy-set",
    "allow-extensions-close",
    "allow-extensions-dev-pick-and-add",
    "allow-extensions-dev-reload",
    "allow-extensions-dev-remove",
    "allow-extensions-dev-set-enabled",
    "allow-extensions-dev-state",
    "allow-extensions-inspect",
    "allow-extensions-install",
    "allow-extensions-list",
    "allow-extensions-open",
    "allow-extensions-open-dir",
    "allow-extensions-pick",
    "allow-extensions-remove",
    "allow-extensions-set-capability",
    "allow-extensions-set-enabled",
    "allow-extensions-stop",
    "allow-i18n-boot",
    "allow-i18n-set-locale",
    "allow-media-activate",
    "allow-media-asset-pick",
    "allow-media-asset-remove",
    "allow-media-assets",
    "allow-media-attach",
    "allow-media-call",
    "allow-media-capabilities",
    "allow-media-config-get",
    "allow-media-config-set",
    "allow-media-connect",
    "allow-media-degrade",
    "allow-media-detach",
    "allow-media-disconnect",
    "allow-media-engine-event",
    "allow-media-engine-ready",
    "allow-media-open",
    "allow-media-pause",
    "allow-media-play",
    "allow-media-resync",
    "allow-media-seek",
    "allow-media-set-loop",
    "allow-media-stats",
    "allow-media-status",
    "allow-wallpaper-detach",
    "allow-wallpaper-display-get",
    "allow-wallpaper-get-visible",
    "allow-wallpaper-monitors",
    "allow-wallpaper-set-display",
    "allow-wallpaper-set-monitor-scene",
    "allow-wallpaper-set-monitor-visible",
    "allow-wallpaper-set-scene-params",
    "allow-wallpaper-set-visible",
    "allow-wallpaper-status",
    "allow-widget-apply-resize",
    "allow-widget-close",
    "allow-widget-open",
    "allow-widget-package-notify",
    "allow-widget-set-transparent",
    "allow-widget-state-get",
    "allow-widget-state-remove",
    "allow-widget-state-set",
    "allow-widget-states",
    "allow-window-prefs-get",
    "allow-window-prefs-set",
    "allow-window-set-frame"
  ]
}
