{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-game-controller",
  "description": "Game package controller windows (label game-controller-*). Generated by scripts/gen-widgets.mjs — do not edit by hand.",
  "windows": [
    "game-controller-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "allow-game-connect",
    "allow-game-snapshot-get",
    "allow-game-command-send",
    "allow-game-report-error",
    "allow-game-detach"
  ]
}
