# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# 由 build.rs 的 AppManifest 自动生成的 app 命令权限（每次构建重建）
/permissions/autogenerated/

# Native host build artifacts（由 native/build-shim.sh 生成）
/native/*.dll
/native/*.obj
/native/*.exp
/native/*.lib
