{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lull",
  "version": "0.1.0",
  "identifier": "app.lull.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:next",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/prebuild.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2022 Kevin Xiao; Copyright (c) 2026 Lull contributors",
    "category": "Productivity",
    "shortDescription": "Lull — 助眠与专注桌面应用",
    "longDescription": "开源的助眠与专注桌面应用：动态壁纸、白噪音、番茄钟都在本地运行。",
    "resources": { "native/lull_native.dll": "lull_native.dll" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
