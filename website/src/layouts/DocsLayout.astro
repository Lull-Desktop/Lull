---
import BaseLayout from "./BaseLayout.astro";
import DocFooter from "../components/site/DocFooter";
import DocNav from "../components/site/DocNav";
import { container } from "../components/ui/layout";
import { getCollection } from "astro:content";
import { groupDocs, repoUrl, sourceUrl, toDocGroups } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** 对应仓库源文档，如 `docs/architecture.md`，页脚据此给出原文链接 */
  source?: string;
}

const { title, description, source } = Astro.props;

// 内容集合只能在 Astro 侧读：这里查好、压成纯数据，再传给 React 侧栏
const groups = toDocGroups(groupDocs(await getCollection("docs")));
const current = Astro.url.pathname.replace(/\/+$/, "");
---

<BaseLayout title={title} description={description}>
  <div
    class:list={[
      container,
      "grid grid-cols-[216px_minmax(0,1fr)] items-start gap-[clamp(28px,4vw,56px)]",
      "pt-[clamp(36px,5vw,64px)] max-[900px]:grid-cols-1 max-[900px]:gap-7",
    ]}
  >
    <DocNav groups={groups} current={current} repoUrl={repoUrl} />

    <div class="min-w-0 max-w-[72ch]">
      <slot />
      <DocFooter
        source={source}
        sourceHref={source ? sourceUrl(source) : undefined}
        issuesUrl={`${repoUrl}/issues`}
        docsTreeUrl={`${repoUrl}/tree/master/docs`}
      />
    </div>
  </div>
</BaseLayout>
