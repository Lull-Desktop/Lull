---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";
import { groupDocs, page, repoUrl, sourceUrl } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** 对应仓库源文档，如 `docs/architecture.md`，页脚据此给出原文链接 */
  source?: string;
}

const { title, description, source } = Astro.props;

const groups = groupDocs(await getCollection("docs"));
const current = Astro.url.pathname.replace(/\/+$/, "");
---

<BaseLayout title={title} description={description}>
  <div class="container doc-shell">
    <nav class="doc-nav" aria-label="文档目录">
      <span class="doc-nav__title">文档</span>
      {groups.map((group) => (
        <div class="doc-nav__group">
          <span class="doc-nav__label">{group.name}</span>
          {group.entries.map((entry) => (
            <a
              href={page(`/docs/${entry.id}/`)}
              aria-current={current.endsWith(`/docs/${entry.id}`) ? "page" : undefined}
            >
              {entry.data.title}
            </a>
          ))}
        </div>
      ))}
      <a class="doc-nav__repo" href={`${repoUrl}/tree/main/docs`} rel="noopener">仓库 docs/ ↗</a>
    </nav>

    <div class="doc-body">
      <slot />
      <div class="doc-footer">
        <span>
          文档随版本一起更新，完整说明见仓库 <code>docs/</code>
          {source && (
            <>
              · 本页对应 <a href={sourceUrl(source)} rel="noopener">{source} ↗</a>
            </>
          )}
        </span>
        <a href={`${repoUrl}/issues`} rel="noopener">发现错误？提个 issue</a>
      </div>
    </div>
  </div>
</BaseLayout>
