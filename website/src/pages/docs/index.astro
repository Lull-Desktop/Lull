---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsIndex from "../../components/site/DocsIndex";
import { getCollection } from "astro:content";
import { groupDocs, repoUrl, toDocGroups } from "../../lib/site";

const groups = toDocGroups(groupDocs(await getCollection("docs")));
---

<BaseLayout
  title="文档"
  description="Lull 的文档目录：快速开始、架构与运行时、场景包与插件开发、多语言方案，以及贡献与许可。"
>
  <DocsIndex groups={groups} repoUrl={repoUrl} />
</BaseLayout>
