---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadHero from "../components/site/DownloadHero";
import FeatureCards from "../components/site/FeatureCards";
import InstallGuide from "../components/site/InstallGuide";
import Rule from "../components/site/Rule";
import { container, section } from "../components/ui/layout";
import { page, repoUrl, releasesUrl } from "../lib/site";
import { release, formatSize, formatDate } from "../lib/release";

// 主推 msi；没有 release.json 时 assets 为空，DownloadHero 会退化成「去 GitHub 下载」
const primaryAsset = release.assets.find((item) => item.key === "windows-msi") ?? release.assets[0];

const toAsset = (item: (typeof release.assets)[number]) => ({
  name: item.name,
  url: item.url,
  size: formatSize(item.size),
  label: item.label,
  hint: item.hint,
});

const primary = primaryAsset ? toAsset(primaryAsset) : null;
const others = release.assets.filter((item) => item !== primaryAsset).map(toAsset);
const published = formatDate(release.publishedAt);

const notes = [
  {
    title: "会改桌面层",
    body: "壁纸挂在 Explorer 的 WorkerW / Progman 之下。撤销挂载、异常恢复与日志都是必需功能，不是「可选优化」。",
  },
  {
    title: "许可不是单一许可",
    body: "应用代码 GPL-3.0-or-later，SDK 接口 Apache-2.0，官方内容与文档 CC BY 4.0。分发改造版前请先看",
    link: { label: "许可与合规", href: page("/docs/licensing/") },
    after: "。",
  },
  {
    title: "还没有在线市场",
    body: "内容包安装是本地行为：只接受单场景包、必须声明整包摘要，暂未做第三方签名与在线更新。",
  },
];
---

<BaseLayout
  title="下载"
  description="下载 Lull（云栖）：Windows 10 / 11 桌面应用。版本号与安装包来自 GitHub Release，与源码同源。"
>
  <DownloadHero
    version={release.version}
    published={published}
    primary={primary}
    others={others}
    releasesUrl={releasesUrl}
    notesUrl={release.notesUrl}
    allReleasesUrl={`${repoUrl}/releases`}
  />

  <Rule />

  <InstallGuide />

  <Rule />

  <section class={section}>
    <div class={container}>
      <div class="mb-[clamp(32px,4vw,52px)] max-w-[60ch]">
        <p class="mb-[18px] text-eyebrow font-medium uppercase tracking-[0.32em] text-green">Know before install</p>
        <h2 class="mb-2.5 text-h2 leading-[1.25] text-mist">安装前该知道的三件事</h2>
      </div>
      <FeatureCards items={notes} client:visible />
    </div>
  </section>
</BaseLayout>
