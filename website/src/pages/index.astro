---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/site/CtaBanner";
import FeatureCards from "../components/site/FeatureCards";
import HomeHero from "../components/site/HomeHero";
import HomePrivacy from "../components/site/HomePrivacy";
import SceneGallery from "../components/site/SceneGallery";
import { container, section } from "../components/ui/layout";
import { page, repoUrl } from "../lib/site";
import { release } from "../lib/release";

const scenes = [
  { file: "scene-bamboo.jpg", name: "竹影", note: "默认 · 雾绿", alt: "竹影场景：深绿夜幕下的竹竿与薄雾" },
  { file: "scene-dusk.jpg", name: "暮色", note: "暖橙", alt: "暮色场景：紫橙渐变的黄昏与山影" },
  { file: "scene-aurora.jpg", name: "极光", note: "冷蓝", alt: "极光场景：夜空中的冷蓝光带" },
  { file: "scene-mist.jpg", name: "雾岚", note: "社区示例", alt: "社区示例场景：雾中山岚" },
];

const features = [
  {
    title: "动态壁纸",
    body: "竹影、暮色、极光三个官方场景。每台显示器一个壁纸窗口，支持复制 / 独立 / 跨屏三种模式与跨屏同步动画。",
    tag: "Core · Win32 桌面层",
    icon: "layers" as const,
  },
  {
    title: "五层声景",
    body: "雨、雷、风、海浪、篝火各自独立混音，主音量、静音与助眠定时互不干扰，关掉哪一层都不会塌。",
    tag: "白噪音",
    icon: "wave" as const,
  },
  {
    title: "番茄钟",
    body: "液态时间沙漏，专注 / 短休 / 长休节奏可调，偏好自动保存，下次打开接着走。",
    tag: "专注",
    icon: "hourglass" as const,
  },
  {
    title: "播放器",
    body: "液态黑胶浮窗，在线氛围声与本地曲目共用一套播放控制，不抢焦点、不挡视线。",
    tag: "音频",
    icon: "disc" as const,
  },
  {
    title: "托盘常驻",
    body: "关闭窗口只是隐藏，只有托盘「退出」才结束进程；托盘「扩展」子菜单直接打开已启用的工具扩展。",
    tag: "窗口",
    icon: "tray" as const,
  },
  {
    title: "可扩展内容",
    body: "外部场景包通过 catalog.json 被发现，支持静态 HTML/CSS 与沙箱脚本场景；zip 拖入安装，装前复核清单与整包摘要。",
    tag: "Extensions",
    icon: "puzzle" as const,
  },
];
---

<BaseLayout>
  {/* 首屏：SplitText 逐字升起标题，唯一用 client:load 的岛 */}
  <HomeHero version={release.version} client:load />

  <SceneGallery scenes={scenes} client:visible />

  <section class={section}>
    <div class={container}>
      <div class="mb-[clamp(32px,4vw,52px)] max-w-[60ch]">
        <p class="mb-[18px] text-eyebrow font-medium uppercase tracking-[0.32em] text-green">All in one place</p>
        <h2 class="mb-2.5 text-h2 leading-[1.25] text-mist">桌面上的一整套安静</h2>
        <p class="text-muted">
          壁纸、声景、计时、播放器不是四个 App，而是同一个窗口体系里的四层。关掉任何一个都不影响其他继续工作。
        </p>
      </div>
      <FeatureCards items={features} client:visible />
    </div>
  </section>

  <CtaBanner
    client:visible
    eyebrow="Open source"
    title="场景可以用 HTML + CSS 写"
    body="Lull 的桌面运行时、场景 SDK、内容格式分层解耦。第三方场景包无需改核心代码，静态包只跑 CSS，脚本包可拿到宿主下发的参数、几何与同步相位。"
    actions={[
      { label: "写一个场景", href: page("/docs/scene-sdk/") },
      { label: "看源码", href: repoUrl, variant: "ghost", external: true },
    ]}
  />

  <HomePrivacy />
</BaseLayout>
