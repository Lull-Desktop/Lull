{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lull.app/schemas/scene-manifest.schema.json",
  "title": "Lull Scene Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "id",
    "name",
    "version",
    "license",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "scene" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "全局唯一 id，建议使用 作者.场景 命名空间。"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "maxLength": 280 },
    "author": { "type": "string", "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "wallpaper.viewport",
          "wallpaper.canvas",
          "wallpaper.sync"
        ]
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*\\.html$",
      "description": "静态内容入口，相对 content 根目录。内容包必填。"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    }
  }
}
