# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# 插件样例构建产物（pnpm widgets:samples:build 生成）
/examples/widgets/*/dist/
__pycache__/

# native host build artifacts（由 scripts/prebuild.mjs 或 test-mode 重新生成）
/src-tauri/native/*.dll
/src-tauri/native/*.obj
/src-tauri/native/*.exp
/src-tauri/native/*.lib

# 内容目录签名私钥（pnpm content:keygen 生成；只在 CI secret 或本机保存）
/.keys/

# sdk build output
/packages/*/dist/

# 本地测试/打包产物（内容包 zip 等）
/artifacts/

# Paraglide 编译产物（pnpm i18n:compile 生成，不入库）
/src/paraglide/

# inlang 工程运行时状态（只有 settings.json 需要入库）
/project.inlang/.lix/
/project.inlang/cache/
/project.inlang/.meta.json
