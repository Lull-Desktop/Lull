{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "packages/**",
      "examples/**/*.ts",
      "examples/**/*.tsx",
      "./*.json",
      "./*.js",
      "./*.ts",
      "./*.mts",
      "./*.mjs",
      "!!dist",
      "!!packages/*/dist",
      "!!src-tauri",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all",
      "react": "all",
      "next": "all"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnresolvedImports": "off",
        "useHookAtTopLevel": "error",
        "useImportExtensions": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useAwaitThenable": "error"
      },
      "suspicious": {
        "useGoogleFontDisplay": "error",
        "noDocumentImportInPage": "error",
        "noHeadImportInDocument": "error",
        "noReactForwardRef": "off"
      },
      "style": {
        "noHeadElement": "error",
        "useComponentExportOnlyModules": "off"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["examples/**/*.ts", "examples/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/widget-sdk/src/vue.ts",
        "packages/widget-sdk/src/vue.test.ts",
        "examples/widgets/pomodoro-vue/**/*.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off",
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": []
  }
}
