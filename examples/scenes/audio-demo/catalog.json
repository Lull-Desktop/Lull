{
  "schemaVersion": 1,
  "scenes": [
    {
      "schemaVersion": 1,
      "type": "scene",
      "id": "demo.audio-scene",
      "name": "声之潮汐（音频响应）",
      "version": "1.0.0",
      "description": "演示 wallpaper.audio：音乐驱动频谱与脉动，音境驱动雾与背景，混合信号驱动整体呼吸。",
      "author": "Lull Demo",
      "license": "CC-BY-4.0",
      "capabilities": [
        "wallpaper.viewport",
        "wallpaper.canvas",
        "wallpaper.params",
        "wallpaper.script",
        "wallpaper.audio"
      ],
      "entry": "scenes/audio-demo/index.html",
      "theme": {
        "background": "#04121a",
        "accent": "#7fd4c8"
      },
      "audio": {
        "sources": [
          "music",
          "noise",
          "mix"
        ],
        "features": [
          "level",
          "bands"
        ]
      },
      "params": [
        {
          "key": "sensitivity",
          "type": "number",
          "label": "响应灵敏度",
          "description": "0.2 几乎不动，2 最敏感；只影响视觉映射，不改播放音量。",
          "default": 1,
          "min": 0.2,
          "max": 2,
          "step": 0.05
        },
        {
          "key": "palette",
          "type": "enum",
          "label": "配色",
          "default": "tide",
          "options": [
            {
              "value": "tide",
              "label": "潮汐"
            },
            {
              "value": "ember",
              "label": "余烬"
            }
          ]
        }
      ],
      "performance": {
        "tier": "low",
        "targetFps": 60
      },
      "compatibility": {
        "hostApi": 5,
        "platforms": [
          "windows"
        ]
      },
      "integrity": {
        "algorithm": "sha256",
        "scope": "package",
        "digest": "c8fe412d7282a55e8e6fab846b5ba309336d8723b5fc8bb0c4eb40aaaa633e64"
      }
    }
  ]
}
