      "license": "MIT",
      "capabilities": [
        "wallpaper.viewport",
        "wallpaper.canvas",
        "wallpaper.script"
      ],
      "entry": "scenes/webgl-fluid/index.html",
      "theme": {
        "background": "#000000",
        "accent": "#4fc3f7"
      },
      "performance": {
        "tier": "high",
        "targetFps": 60
      },
      "compatibility": {
        "hostApi": 1,
        "platforms": [
          "windows"
        ]
      },
