{
  "schemaVersion": 1,
  "scenes": [
    {
      "schemaVersion": 1,
      "type": "scene",
      "id": "lull.bamboo",
      "name": "竹影",
      "version": "1.2.0",
      "description": "深夜竹林、薄雾与远山，Lull 的默认壁纸。",
      "author": "Lull",
      "license": "GPL-3.0-or-later",
      "capabilities": [
        "wallpaper.viewport",
        "wallpaper.canvas",
        "wallpaper.sync",
        "wallpaper.params",
        "wallpaper.script"
      ],
      "entry": "scenes/bamboo/index.html",
      "theme": {
        "background": "#07110f",
        "accent": "#a9bf9b"
      },
      "params": [
        {
          "key": "mist",
          "type": "number",
          "label": "薄雾浓度",
          "description": "0 为无雾（清爽），1 为最浓（整屏雾幔 + 三层带雾）。",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        }
      ],
      "performance": {
        "tier": "low",
        "targetFps": 60
      },
      "compatibility": {
        "hostApi": 1,
        "platforms": ["windows"]
      }
    }
  ]
}
